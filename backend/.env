# 后端环境配置文件
# 使用方式：复制本文件为 .env，按实际环境修改后即可启动

# 应用名称
APP_NAME=智慧校园数据中心管理软件

# 接口统一前缀
API_PREFIX=/api/v1

# 数据库连接串（PostgreSQL）
DATABASE_URL=postgresql+psycopg://smart_campus_dc:smart_campus_dc@localhost:5433/smart_campus_dc_db

# JWT 签名密钥（生产环境务必修改为随机长字符串）
SECRET_KEY=smart-campus-dc-secret-key-please-change-in-production-2026

# JWT 签名算法
ALGORITHM=HS256

# 令牌有效期（分钟），默认 12 小时
ACCESS_TOKEN_EXPIRE_MINUTES=720

# 允许跨域访问的前端地址，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
